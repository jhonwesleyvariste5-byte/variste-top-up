<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Variste Top-Up</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#f5f5f5;
  color:#222;
}
header{
  background:#fff;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  box-shadow:0 2px 8px #ddd;
}
.logo{
  font-size:23px;
  font-weight:bold;
  color:#e00000;
}
.menu-btn{
  font-size:28px;
  cursor:pointer;
}
.search{
  margin:25px 15px;
  display:flex;
}
.search input{
  width:100%;
  padding:16px;
  border:1px solid #ddd;
  border-radius:30px 0 0 30px;
  font-size:16px;
}
.search button{
  width:60px;
  border:0;
  background:#e00000;
  color:white;
  border-radius:0 30px 30px 0;
  font-size:22px;
}
.banner{
  margin:15px;
  padding:30px 20px;
  border-radius:15px;
  background:linear-gradient(135deg,#111827,#b00000);
  color:white;
  text-align:center;
}
.banner h1{font-size:28px;margin-bottom:10px}
.banner p{font-size:16px}
.section{
  padding:20px 15px;
}
.section h2{
  margin-bottom:15px;
}
.categories{
  display:flex;
  gap:10px;
  overflow:auto;
  margin-bottom:20px;
}
.categories button{
  border:1px solid #ddd;
  background:white;
  padding:12px 20px;
  border-radius:25px;
  white-space:nowrap;
}
.categories button:first-child{
  color:#e00000;
  border-color:#e00000;
}
.games{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
}
.game{
  background:white;
  border-radius:15px;
  padding:15px;
  box-shadow:0 2px 8px #ddd;
  cursor:pointer;
}
.game .icon{
  height:120px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:55px;
  background:linear-gradient(135deg,#ff4b2b,#ff416c);
}
.game h3{
  margin-top:10px;
  font-size:15px;
}
.topup{
  background:white;
  margin:15px;
  padding:20px;
  border-radius:18px;
  box-shadow:0 2px 10px #ddd;
}
.topup input,.topup select{
  width:100%;
  padding:15px;
  margin:8px 0 15px;
  border:1px solid #ccc;
  border-radius:10px;
  font-size:16px;
}
.topup button{
  width:100%;
  padding:16px;
  border:0;
  border-radius:10px;
  background:#10c878;
  color:white;
  font-size:17px;
  font-weight:bold;
}
.side-menu{
  display:none;
  position:fixed;
  top:0;
  right:0;
  width:85%;
  max-width:350px;
  height:100%;
  background:white;
  z-index:10;
  padding:25px;
  box-shadow:-5px 0 15px #999;
}
.side-menu.active{display:block}
.side-menu h2{
  color:#e00000;
  margin-bottom:25px;
}
.side-menu a{
  display:block;
  padding:17px 5px;
  border-bottom:1px solid #eee;
  text-decoration:none;
  color:#222;
  font-weight:bold;
}
.close{
  float:right;
  font-size:28px;
  cursor:pointer;
}
footer{
  background:#111827;
  color:white;
  text-align:center;
  padding:30px 15px;
  margin-top:30px;
}
</style>
</head>

<body>

<header>
  <div class="logo">💎 VARISTE TOP-UP</div>
  <div class="menu-btn" onclick="openMenu()">☰</div>
</header>

<div class="search">
  <input type="text" placeholder="Produits...">
  <button>🔍</button>
</div>

<div class="banner">
  <h1>💎 VARISTE TOP-UP</h1>
  <p>Rechargez vos jeux rapidement et facilement</p>
</div>

<section class="section">
  <h2>POPILÈ</h2>

  <div class="categories">
    <button>Jeux</button>
    <button>GIFT CARD</button>
    <button>STREAMING</button>
    <button>Autres</button>
  </div>

  <div class="games">
    <div class="game">
      <div class="icon">🔥</div>
      <h3>Free Fire</h3>
    </div>

    <div class="game">
      <div class="icon">💎</div>
      <h3>Free Fire Europe</h3>
    </div>

    <div class="game">
      <div class="icon">🎯</div>
      <h3>Blood Strike</h3>
    </div>

    <div class="game">
      <div class="icon">🎮</div>
      <h3>PUBG Mobile</h3>
    </div>
  </div>
</section>

<div class="topup">
  <h2>🔥 Rechargez Free Fire</h2>
  <br>

  <label>ID du joueur</label>
  <input type="text" placeholder="Entrez votre ID Free Fire">

  <label>Choisir les diamants</label>
  <select>
    <option>100 Diamants</option>
    <option>310 Diamants</option>
    <option>520 Diamants</option>
    <option>1060 Diamants</option>
    <option>2180 Diamants</option>
  </select>

  <label>Nom du client</label>
  <input type="text" placeholder="Votre nom">

  <button onclick="commander()">Commander maintenant</button>
</div>

<div class="side-menu" id="menu">
  <span class="close" onclick="closeMenu()">×</span>
  <h2>💎 VARISTE TOP-UP</h2>

  <a href="#">🏠 ACCUEIL</a>
  <a href="#">💰 WALLET</a>
  <a href="#">➕ DEPO NATCASH</a>
  <a href="#">📢 SONDAGE FREE FIRE</a>
  <a href="#">🛒 VANN AK ACHTE KONT</a>
  <a href="#">📋 MES ACHATS</a>
  <a href="#">🎁 REFERRAL & RÉCOMPENSES</a>
  <a href="#">🎁 RÉCOMPENSES FREE FIRE</a>
  <a href="#">❓ PAJ ÈD</a>
  <a href="#">📄 CONDITIONS GÉNÉRALES</a>
  <a href="#">👤 KONT MWEN</a>
</div>

<footer>
  <h3>💎 VARISTE TOP-UP</h3>
  <br>
  <p>Recharge Free Fire rapidement et facilement.</p>
  <br>
  <p>© 2026 Variste Top-Up</p>
</footer>

<script>
function openMenu(){
  document.getElementById("menu").classList.add("active");
}

function closeMenu(){
  document.getElementById("menu").classList.remove("active");
}

function commander(){
  alert("Kòmand ou resevwa! N ap kontakte w pou konfimasyon.");
}
</script>

</body>
</html>
